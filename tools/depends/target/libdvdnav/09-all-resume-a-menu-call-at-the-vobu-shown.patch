+}
+
+dvdnav_status_t dvdnav_menu_call_from(dvdnav_t *this, DVDMenuID_t menu,
+                                      const dvdnav_nav_position_t *pos) {
   vm_t *try_vm;
 
   pthread_mutex_lock(&this->vm_lock);
@@ -499,6 +505,19 @@ dvdnav_status_t dvdnav_menu_call(dvdnav_t *this, DVDMenuID_t menu) {
     goto fail;
   }
 
+  /* the resume point is the position the player shows, not the one read */
+  if (pos) {
+    if (pos->domain != DVD_DOMAIN_VTSTitle || try_vm->state.domain != DVD_DOMAIN_VTSTitle ||
+        !set_VTS_PROG(try_vm, pos->vts, pos->vts_title, pos->pgcn, pos->pgn) ||
+        pos->cell < 1 || pos->cell > try_vm->state.pgc->nr_of_cells) {
+      vm_free_copy(try_vm);
+      printerr("Invalid NAV position.");
+      goto fail;
+    }
+    try_vm->state.cellN = pos->cell;
+    try_vm->state.blockN = pos->block;
+  }
+
   if ( (menu == DVD_MENU_Escape) && (this->vm->state.domain != DVD_DOMAIN_VTSTitle)) {
     /* Try resume */
     if (vm_jump_resume(try_vm) && !try_vm->stopped) {
